# Required for pitch deck uploads through Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Required for pitch form email notifications through Resend.
RESEND_API_KEY=

# Optional. Comma-separated list. Defaults to pitch@arcventures.gr.
# Example: pitch@arcventures.gr,partner@arcventures.gr,ops@arcventures.gr,hello@arcventures.gr
PITCH_FORM_TO_EMAIL=

# Optional. Use a verified Resend sender for production.
PITCH_FORM_FROM_EMAIL=
